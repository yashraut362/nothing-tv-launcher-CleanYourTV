<?xml version="1.0" encoding="utf-8"?>
<!-- Ground and surface are Nothing's own dark-mode pair from nothing.tech's design tokens
     (greyscale-dm-dark 4,4,4 and greyscale-dm-light 24,24,24). This TV shows the launcher at full
     range, so RGB 16 "video black" read as grey; Nothing's near-black does not. Text stays at 235. -->
<resources>
    <color name="ground">#040404</color>          <!-- Nothing black (greyscale-dm-dark) -->
    <color name="surface">#181818</color>         <!-- Nothing dark-mode surface (greyscale-dm-light) -->
    <color name="hairline">#333333</color>        <!-- 1dp rules and outlines -->
    <color name="hairline_strong">#5A5A5A</color> <!-- panel border -->
    <color name="text">#EBEBEB</color>            <!-- RGB 235: video white -->
    <color name="text_2">#A3A3A3</color>          <!-- labels, 7:1 on ground -->
    <color name="text_3">#6E6E6E</color>          <!-- index numerals only, never words -->
    <color name="accent">#D71921</color>          <!-- one red point: a state, never a surface -->
</resources>
