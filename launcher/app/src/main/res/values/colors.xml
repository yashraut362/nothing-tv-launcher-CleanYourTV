<?xml version="1.0" encoding="utf-8"?>
<!-- Everything stays inside the TV-safe RGB 16-235 range: no bloom, no black crush. -->
<resources>
    <color name="ground">#101010</color>          <!-- RGB 16: video black -->
    <color name="surface">#1A1A1A</color>         <!-- banner-less tiles, panels -->
    <color name="hairline">#333333</color>        <!-- 1dp rules and outlines -->
    <color name="hairline_strong">#5A5A5A</color> <!-- panel border -->
    <color name="text">#EBEBEB</color>            <!-- RGB 235: video white -->
    <color name="text_2">#A3A3A3</color>          <!-- labels, 7:1 on ground -->
    <color name="text_3">#6E6E6E</color>          <!-- index numerals only, never words -->
    <color name="accent">#D71921</color>          <!-- one red point: a state, never a surface -->
</resources>
