<?xml version="1.0" encoding="utf-8"?>
<!-- Edit this file to change the home screen, then run ../../../../../build-install.sh -->
<resources>
    <!-- Grid columns (3 for the rail layout; 4 fits but the tiles get small). -->
    <integer name="columns">3</integer>

    <!-- Pinned apps come first in the grid, in this order; the rest follow alphabetically. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>in.startv.hotstar</item>
        <item>com.graymatrix.did</item>
    </string-array>

    <!-- Packages never shown in the grid. -->
    <string-array name="hidden_apps">
    </string-array>

    <!-- Tile shape: "circle" (each app's icon in a circle, names under all of them)
         or "banner" (the apps' own 16:9 banners, the name only under the focused one). -->
    <string name="tile_shape" translatable="false">circle</string>

    <!-- Columns for circles; "columns" above is used for banners. -->
    <integer name="circle_columns">4</integer>

    <!-- Screensaver weather (Open-Meteo). Leave the coordinates empty to use the city of the TV's
         internet address, looked up once a week; set them (and a name) to pin a place. -->
    <string name="weather_latitude" translatable="false"></string>
    <string name="weather_longitude" translatable="false"></string>
    <string name="weather_place" translatable="false"></string>
    <!-- "celsius" or "fahrenheit" -->
    <string name="weather_unit" translatable="false">celsius</string>

    <!-- Wallpaper brightness, 0-100. The wallpaper itself is a file pushed to the TV, see README. -->
    <integer name="wallpaper_brightness">55</integer>
</resources>
