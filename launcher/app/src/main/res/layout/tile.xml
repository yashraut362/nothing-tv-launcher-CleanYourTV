<?xml version="1.0" encoding="utf-8"?>
<!-- One app: its 16:9 banner, then an index numeral and, on focus, its name. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@drawable/tile_bg">

        <ImageView
            android:id="@+id/banner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/fallback_label"
            style="@style/Label"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/caption_height"
        android:layout_marginTop="@dimen/caption_top"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/index"
            style="@style/Label"
            android:textColor="@color/text_3" />

        <TextView
            android:id="@+id/label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:alpha="0"
            android:ellipsize="end"
            android:fontFamily="@font/geist_medium"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="@dimen/text_name" />
    </LinearLayout>
</LinearLayout>
